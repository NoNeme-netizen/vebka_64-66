# Переменные окружения «Манчкин-пикера»
# Скопируйте в .env и заполните значения (файл .env в git не попадает).

# --- Supabase (облачная база данных) ---
# Project URL (Settings -> API)
SUPABASE_URL=
# service_role secret (Settings -> API -> service_role; ТОЛЬКО для сервера)
SUPABASE_SERVICE_ROLE_KEY=
